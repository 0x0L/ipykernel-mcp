{
  "mcpServers": {
    "jupyter-python": {
      "command": "uv",
      "args": [
        "run",
        "--project", "/absolute/path/to/ipykernel-mcp",
        "--locked",
        "--dev",
        "ipykernel-mcp",
        "--jupyter", "/absolute/path/to/ipykernel-mcp/.venv/bin/jupyter",
        "--kernel", "python3",
        "--cwd", "/absolute/path/to/project"
      ]
    }
  }
}
